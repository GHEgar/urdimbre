{
    "name": "urdimbre",
    "version": "0.6.1",
    "description": "Headless map layer core: OGC client, CQL composer, layer catalog and reconciler for OpenLayers and MapLibre.",
    "keywords": [
        "ogc",
        "wms",
        "wfs",
        "wps",
        "getcapabilities",
        "geoserver",
        "cql",
        "ecql",
        "headless",
        "gis",
        "openlayers",
        "maplibre",
        "layers",
        "reconciler",
        "url-state",
        "legend",
        "getfeatureinfo"
    ],
    "license": "AGPL-3.0-only",
    "author": "Edgar Villarreal",
    "type": "module",
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/GHEgar/urdimbre.git"
    },
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./ogc": {
            "types": "./dist/ogc/index.d.ts",
            "import": "./dist/ogc/index.js"
        },
        "./cql": {
            "types": "./dist/cql/index.d.ts",
            "import": "./dist/cql/index.js"
        },
        "./catalog": {
            "types": "./dist/catalog/index.d.ts",
            "import": "./dist/catalog/index.js"
        },
        "./arbiter": {
            "types": "./dist/arbiter/index.d.ts",
            "import": "./dist/arbiter/index.js"
        },
        "./state": {
            "types": "./dist/state/index.d.ts",
            "import": "./dist/state/index.js"
        },
        "./legend": {
            "types": "./dist/legend/index.d.ts",
            "import": "./dist/legend/index.js"
        },
        "./identify": {
            "types": "./dist/identify/index.d.ts",
            "import": "./dist/identify/index.js"
        },
        "./geocode": {
            "types": "./dist/geocode/index.d.ts",
            "import": "./dist/geocode/index.js"
        },
        "./ol": {
            "types": "./dist/ol/index.d.ts",
            "import": "./dist/ol/index.js"
        },
        "./maplibre": {
            "types": "./dist/maplibre/index.d.ts",
            "import": "./dist/maplibre/index.js"
        }
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "peerDependencies": {
        "maplibre-gl": ">=6",
        "ol": ">=10"
    },
    "peerDependenciesMeta": {
        "maplibre-gl": {
            "optional": true
        },
        "ol": {
            "optional": true
        }
    },
    "devDependencies": {
        "@npmegar/eslint-config": "^0.4.0",
        "@types/node": "^24.0.0",
        "eslint": "^10.12.0",
        "happy-dom": "^21.0.4",
        "maplibre-gl": "^6.13.0",
        "ol": "^10.11.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.1",
        "vitest": "^5.0.3"
    }
}
